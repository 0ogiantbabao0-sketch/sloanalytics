# Node.js 24 / persistent disk. Relative paths resolve from project root.
DATA_DIR=./data
# Set a long random value locally. Required for imports; never NEXT_PUBLIC_.
ADMIN_IMPORT_TOKEN=
# Optional: JSON config with verified permissions; see docs/source-integration.md.
PERMITTED_SOURCES_FILE=
# Private production access (set secrets in Render, never commit values).
PRIVATE_ACCESS=true
OWNER_PASSWORD=
OWNER_SESSION_SECRET=
# CSV pipeline limits (bytes / records).
IMPORT_MAX_BYTES=20000000
IMPORT_MAX_ROWS=100000
IMPORT_MAX_RECORD_BYTES=100000
